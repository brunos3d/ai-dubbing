# =============================================================================
# ai-dubbing .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/
.installed.cfg
*.egg-info

# Virtual environments
.venv/
venv/
env/
.python-version

# uv
uv.lock
.uv/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache

# mypy / pyright
.mypy_cache/
.pyright_cache/

# jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Project artefacts (re-derivable from source)
# -----------------------------------------------------------------------------
# working/  — all intermediate stage outputs (diarization, transcripts, etc.)
working/
# output/  — final rendered audio/video
output/

# Per-file log outputs
logs/*.log
logs/*.log.*
# keep an empty .gitkeep in logs/ so the directory is tracked
!logs/.gitkeep

# -----------------------------------------------------------------------------
# Model / cache files (downloaded on demand)
# -----------------------------------------------------------------------------
models/cache/
models/hf_cache/
models/torch_hub/
models/xdg/
models/**/*.bin
models/**/*.safetensors
models/**/*.gguf
models/**/*.pt
models/**/*.pth
models/**/*.onnx

# Generic ML cache locations
.huggingface/
hf_cache/
torch_hub/
xdg/

# -----------------------------------------------------------------------------
# Media inputs and outputs (too large for git)
# -----------------------------------------------------------------------------
# Original user-supplied video at the project root
input-video.mp4
input-video.mkv
input-video.mov
input-video.mp3
input-video.wav
input-video.flac
input-video.*

# Anything dropped into the input/ directory (sources are user-supplied)
input/
# except allow a tracked README explaining the convention
!input/.gitkeep

# Any large media artefact in output (already covered by output/ rule above)
# but also block stray copies at the project root
*.tmp.mp4
*.tmp.wav

# Catch-all: do NOT commit any top-level media files. Sources and rendered
# outputs must stay out of git history; they belong on object storage or
# a release artefact pipeline.
/*.mp4
/*.mkv
/*.mov
/*.wav
/*.flac
/*.mp3
/*.webm
# but allow tracking a small README
!/*.md

# -----------------------------------------------------------------------------
# OS / editor / shell artefacts
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
.*.sw[a-p]

# Shell / build
*.bak
*.tmp
*.temp
.cache/
__pycache__/
*.py.bak

# -----------------------------------------------------------------------------
# Logs and profiling
# -----------------------------------------------------------------------------
*.log
*.out
*.err
nohup.out
core
core.*
*.dSYM
*.su

# pytest / coverage
htmlcov/
.coverage
.coverage.*
.tox/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Files generated by tools we may add later
.mypy.ini
.mypy_cache/
*.prof
*.lprof
.ipynb_checkpoints/
